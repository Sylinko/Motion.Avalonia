<!--  ReSharper disable Xaml.RedundantResource  -->
<UserControl
  x:Class="Motion.Avalonia.Demo.Views.KeyFrameMotionPage" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Motion.Avalonia.Demo.Controls"
  xmlns:converters="using:Motion.Avalonia.Demo.Converters" xmlns:motion="using:Motion.Avalonia"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" xmlns:tabler="clr-namespace:Tabler.Avalonia;assembly=Tabler.Avalonia">
  <UserControl.Styles>
    <Style Selector="shadui|SmoothBorder.SequenceTile">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BackgroundSizing" Value="InnerBorderEdge"/>
      <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="CornerSmoothing" Value="0.6"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="shadui|SmoothBorder.SequenceIconBadge">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="CornerSmoothing" Value="0.6"/>
      <Setter Property="BorderBrush" Value="#48FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="shadui|SmoothBorder.TimelineTile">
      <Setter Property="Background" Value="#52121D3A"/>
      <Setter Property="BackgroundSizing" Value="InnerBorderEdge"/>
      <Setter Property="BorderBrush" Value="#52FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="CornerSmoothing" Value="0.6"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="shadui|SmoothBorder.TimelineSignal">
      <Setter Property="Background" Value="#4A0F172D"/>
      <Setter Property="BackgroundSizing" Value="InnerBorderEdge"/>
      <Setter Property="BorderBrush" Value="#48FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="CornerSmoothing" Value="0.6"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style Selector="TextBlock.TimelineKicker">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#FFB8CCF0"/>
      <Setter Property="LetterSpacing" Value="0.7"/>
    </Style>

    <Style Selector="TextBlock.TimelineBody">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="Foreground" Value="#DCE6F5FF"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel
      MaxWidth="{StaticResource DemoPageMaxWidth}"
      Margin="{StaticResource DemoPageMargin}"
      HorizontalAlignment="Stretch" Spacing="32">
      <StackPanel Spacing="8">
        <TextBlock
          Classes="DemoEyebrow" Text="KEYFRAME MOTION"/>
        <TextBlock
          Classes="DemoTitle" Text="Sample progress or author time."/>
        <TextBlock
          Classes="DemoDescription" MaxWidth="768"
          HorizontalAlignment="Left" Text="SequenceMotion samples externally supplied progress, while TimelineMotion evaluates authored times and exposes a frame-aligned player. Each property follows only the keyframes that explicitly author it."/>
      </StackPanel>

      <controls:DemoExample
        Title="Externally driven progress sequence" HorizontalContentAlignment="Stretch"
        Description="SequenceMotion has no player. Drag the Slider to supply Progress directly and sample four declarative Cue keyframes across frosted-glass cards over a geometric wallpaper.">
        <StackPanel Spacing="16">
          <Slider
            x:Name="SequenceSlider" LargeChange="0.1"
            Maximum="1" Minimum="0"
            SmallChange="0.01" TickFrequency="0.3333333333333333"
            ValueChanged="OnSequenceSliderValueChanged"/>

          <UniformGrid Columns="4">
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="ORBIT"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="COLUMNS" TextAlignment="Center"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="FOCUS" TextAlignment="Center"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="STACK" TextAlignment="Right"/>
          </UniformGrid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock
              x:Name="SequenceFrameLabel" Grid.Column="0"
              FontWeight="SemiBold" Text="Orbit"/>
            <TextBlock
              Grid.Column="1" FontFamily="Cascadia Mono,Consolas"
              Foreground="{DynamicResource MutedColor}"
              Text="{Binding #SequenceSlider.Value, StringFormat='Progress \{0:0.00\}'}"/>
          </Grid>

          <shadui:SmoothBorder
            Height="424" BorderBrush="#33FFFFFF"
            BorderThickness="1"
            ClipToBounds="True" CornerRadius="24"
            CornerSmoothing="0.6">
            <Panel>
              <controls:ShaderWallpaper Pattern="FlatGeometric" Speed="0.8"/>

              <motion:MotionPanel
                Margin="14" ClipToBounds="True">
                <motion:MotionPanel.Motion>
                  <motion:SequenceMotion Progress="{Binding #SequenceSlider.Value}">
                    <motion:SequenceMotionKeyFrame Cue="0%">
                      <DataTemplate>
                        <UniformGrid
                          Columns="2" Rows="2">
                          <motion:MotionSlot
                            x:Name="AlphaTile" Margin="8"/>
                          <motion:MotionSlot
                            x:Name="BetaTile" Margin="8"/>
                          <motion:MotionSlot
                            x:Name="GammaTile" Margin="8"/>
                          <motion:MotionSlot
                            x:Name="DeltaTile" Margin="8"/>
                        </UniformGrid>
                      </DataTemplate>
                    </motion:SequenceMotionKeyFrame>
                    <motion:SequenceMotionKeyFrame Cue="33.33333333333333%">
                      <DataTemplate>
                        <UniformGrid Columns="4">
                          <motion:MotionSlot
                            x:Name="AlphaTile" Margin="8"/>
                          <motion:MotionSlot
                            x:Name="BetaTile" Margin="8"/>
                          <motion:MotionSlot
                            x:Name="GammaTile" Margin="8"/>
                          <motion:MotionSlot
                            x:Name="DeltaTile" Margin="8"/>
                        </UniformGrid>
                      </DataTemplate>
                    </motion:SequenceMotionKeyFrame>
                    <motion:SequenceMotionKeyFrame Cue="66.66666666666666%">
                      <DataTemplate>
                        <Grid
                          ColumnDefinitions="1.65*,*" ColumnSpacing="4">
                          <motion:MotionSlot
                            x:Name="AlphaTile" Grid.Column="0"
                            Margin="8"/>
                          <UniformGrid
                            Grid.Column="1" Rows="3">
                            <motion:MotionSlot
                              x:Name="BetaTile" Margin="8"/>
                            <motion:MotionSlot
                              x:Name="GammaTile" Margin="8"/>
                            <motion:MotionSlot
                              x:Name="DeltaTile" Margin="8"/>
                          </UniformGrid>
                        </Grid>
                      </DataTemplate>
                    </motion:SequenceMotionKeyFrame>
                    <motion:SequenceMotionKeyFrame Cue="100%">
                      <DataTemplate>
                        <UniformGrid Rows="4">
                          <motion:MotionSlot
                            x:Name="AlphaTile" Margin="6"/>
                          <motion:MotionSlot
                            x:Name="BetaTile" Margin="6"/>
                          <motion:MotionSlot
                            x:Name="GammaTile" Margin="6"/>
                          <motion:MotionSlot
                            x:Name="DeltaTile" Margin="6"/>
                        </UniformGrid>
                      </DataTemplate>
                    </motion:SequenceMotionKeyFrame>
                  </motion:SequenceMotion>
                </motion:MotionPanel.Motion>

                <shadui:SmoothBorder
                  x:Name="AlphaTile" Classes="SequenceTile"
                  BorderBrush="#667DD3FC">
                  <Border
                    Padding="18,14" BackdropEffect="blur(24)" BackdropEffectCache="Volatile"
                    Background="#450B1D3B">
                    <Grid
                      VerticalAlignment="Center" ColumnDefinitions="Auto,*"
                      ColumnSpacing="14">
                      <shadui:SmoothBorder
                        Classes="SequenceIconBadge" Background="#4538BDF8">
                        <tabler:TablerIcon
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="#FFE0F2FE" Kind="Compass"
                          Size="19" StrokeWidth="1.9"/>
                      </shadui:SmoothBorder>
                      <StackPanel
                        Grid.Column="1" VerticalAlignment="Center"
                        Spacing="3">
                        <StackPanel
                          Orientation="Horizontal" Spacing="8">
                          <TextBlock
                            FontSize="17" FontWeight="SemiBold"
                            Foreground="White" Text="Alpha"/>
                          <TextBlock
                            VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas"
                            FontSize="11" Foreground="#A6BAE6FD"
                            Text="01"/>
                        </StackPanel>
                        <TextBlock
                          FontSize="12.5" Foreground="#E4F0FAFF"
                          Text="Stable control, changing bounds." TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </shadui:SmoothBorder>

                <shadui:SmoothBorder
                  x:Name="BetaTile" Classes="SequenceTile"
                  BorderBrush="#66D8B4FE">
                  <Border
                    Padding="18,14" BackdropEffect="blur(24)" BackdropEffectCache="Volatile"
                    Background="#4523113D">
                    <Grid
                      VerticalAlignment="Center" ColumnDefinitions="Auto,*"
                      ColumnSpacing="14">
                      <shadui:SmoothBorder
                        Classes="SequenceIconBadge" Background="#45A855F7">
                        <tabler:TablerIcon
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="#FFF3E8FF" Kind="WaveSine"
                          Size="19" StrokeWidth="1.9"/>
                      </shadui:SmoothBorder>
                      <StackPanel
                        Grid.Column="1" VerticalAlignment="Center"
                        Spacing="3">
                        <StackPanel
                          Orientation="Horizontal" Spacing="8">
                          <TextBlock
                            FontSize="17" FontWeight="SemiBold"
                            Foreground="White" Text="Beta"/>
                          <TextBlock
                            VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas"
                            FontSize="11" Foreground="#A6E9D5FF"
                            Text="02"/>
                        </StackPanel>
                        <TextBlock
                          FontSize="12.5" Foreground="#E4F5ECFF"
                          Text="Driven by continuous progress." TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </shadui:SmoothBorder>

                <shadui:SmoothBorder
                  x:Name="GammaTile" Classes="SequenceTile"
                  BorderBrush="#666EE7B7">
                  <Border
                    Padding="18,14" BackdropEffect="blur(24)" BackdropEffectCache="Volatile"
                    Background="#450B2926">
                    <Grid
                      VerticalAlignment="Center" ColumnDefinitions="Auto,*"
                      ColumnSpacing="14">
                      <shadui:SmoothBorder
                        Classes="SequenceIconBadge" Background="#4510B981">
                        <tabler:TablerIcon
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="#FFD1FAE5" Kind="ArrowsExchange"
                          Size="19" StrokeWidth="1.9"/>
                      </shadui:SmoothBorder>
                      <StackPanel
                        Grid.Column="1" VerticalAlignment="Center"
                        Spacing="3">
                        <StackPanel
                          Orientation="Horizontal" Spacing="8">
                          <TextBlock
                            FontSize="17" FontWeight="SemiBold"
                            Foreground="White" Text="Gamma"/>
                          <TextBlock
                            VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas"
                            FontSize="11" Foreground="#A6A7F3D0"
                            Text="03"/>
                        </StackPanel>
                        <TextBlock
                          FontSize="12.5" Foreground="#E4ECFAF4"
                          Text="Seekable in either direction." TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </shadui:SmoothBorder>

                <shadui:SmoothBorder
                  x:Name="DeltaTile" Classes="SequenceTile"
                  BorderBrush="#66FDBA74">
                  <Border
                    Padding="18,14" BackdropEffect="blur(24)" BackdropEffectCache="Volatile"
                    Background="#45331C0F">
                    <Grid
                      VerticalAlignment="Center" ColumnDefinitions="Auto,*"
                      ColumnSpacing="14">
                      <shadui:SmoothBorder
                        Classes="SequenceIconBadge" Background="#45F59E0B">
                        <tabler:TablerIcon
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="#FFFEF3C7" Kind="ClockOff"
                          Size="19" StrokeWidth="1.9"/>
                      </shadui:SmoothBorder>
                      <StackPanel
                        Grid.Column="1" VerticalAlignment="Center"
                        Spacing="3">
                        <StackPanel
                          Orientation="Horizontal" Spacing="8">
                          <TextBlock
                            FontSize="17" FontWeight="SemiBold"
                            Foreground="White" Text="Delta"/>
                          <TextBlock
                            VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas"
                            FontSize="11" Foreground="#A6FDE68A"
                            Text="04"/>
                        </StackPanel>
                        <TextBlock
                          FontSize="12.5" Foreground="#E4FFF6E8"
                          Text="No clock belongs to the panel." TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </shadui:SmoothBorder>
              </motion:MotionPanel>
            </Panel>
          </shadui:SmoothBorder>
        </StackPanel>
      </controls:DemoExample>

      <controls:DemoExample
        Title="Authored timeline and player transport" HorizontalContentAlignment="Stretch"
        Description="TimelineMotion evaluates absolute KeyTime values. Scrub at any moment, pause and resume its player, or enable Loop to replay this closed keyframe sequence.">
        <StackPanel Spacing="16">
          <Grid
            ColumnDefinitions="40,*,Auto,Auto" ColumnSpacing="12">
            <Grid
              Grid.Column="0" Width="40"
              Height="40">
              <Button
                Classes="Primary Compact Uniform Rounded"
                shadui:ButtonAssist.Icon="{tabler:TablerIconContent PlayerPlay}"
                shadui:ButtonAssist.IconSize="16"
                Command="{Binding #TimelineMotion.Player.Play}"
                IsVisible="{Binding #TimelineMotion.Player.State, Converter={x:Static converters:MotionConverters.IsNotPlaying}}"
                ToolTip.Tip="Play or resume"/>
              <Button
                Classes="Primary Compact Uniform Rounded"
                shadui:ButtonAssist.Icon="{tabler:TablerIconContent PlayerPause}"
                shadui:ButtonAssist.IconSize="16"
                Command="{Binding #TimelineMotion.Player.Pause}"
                IsVisible="{Binding #TimelineMotion.Player.State, Converter={x:Static converters:MotionConverters.IsPlaying}}"
                ToolTip.Tip="Pause"/>
            </Grid>
            <Slider
              Grid.Column="1" VerticalAlignment="Center"
              LargeChange="0.5"
              Maximum="{Binding #TimelineMotion.Duration, Converter={x:Static converters:MotionConverters.TimeSpanSeconds}}"
              Minimum="0" SmallChange="0.1"
              TickFrequency="1"
              Value="{Binding #TimelineMotion.Time, Mode=TwoWay, Converter={x:Static converters:MotionConverters.TimeSpanSeconds}}"/>
            <TextBlock
              Grid.Column="2" MinWidth="96"
              VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas"
              Foreground="{DynamicResource MutedColor}">
              <Run Text="{Binding #TimelineMotion.Time, Converter={x:Static converters:MotionConverters.TimelineTimestamp}}"/>
              <Run Text="/"/>
              <Run Text="{Binding #TimelineMotion.Duration, Converter={x:Static converters:MotionConverters.TimelineTimestamp}}"/>
            </TextBlock>
            <CheckBox
              Grid.Column="3" VerticalAlignment="Center"
              Content="Loop"
              IsChecked="{Binding #TimelineMotion.Loop, Mode=TwoWay}"/>
          </Grid>

          <UniformGrid Columns="5">
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="SEED · 0.0"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="CONSTELLATION · 1.4" TextAlignment="Center"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="STREAM · 3.2" TextAlignment="Center"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="FOCUS · 5.2" TextAlignment="Center"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="SEED · 7.0" TextAlignment="Right"/>
          </UniformGrid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock
              x:Name="TimelineFrameLabel" Grid.Column="0"
              FontWeight="SemiBold" Text="Seed"/>
            <TextBlock
              Grid.Column="1"
              Foreground="{DynamicResource MutedColor}"
              Text="Destination keyframes own easing"/>
          </Grid>

          <shadui:SmoothBorder
            Height="492" BorderBrush="#33FFFFFF"
            BorderThickness="1"
            ClipToBounds="True" CornerRadius="24"
            CornerSmoothing="0.6">
            <Panel>
              <controls:ShaderWallpaper Pattern="DotGridAurora" Speed="0.8"/>

              <motion:MotionPanel ClipToBounds="True">
                <motion:MotionPanel.Motion>
                  <motion:TimelineMotion x:Name="TimelineMotion">
                    <!-- 0.0s SEED -->
                    <motion:TimelineMotionKeyFrame KeyTime="0:0:0">
                      <DataTemplate>
                        <Panel Margin="20">
                          <motion:MotionSlot
                            x:Name="TimelineHalo" Width="280"
                            Height="280" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Opacity="0.45"
                            RenderTransform="scale(0.76) rotate(0deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="0"/>
                          <motion:MotionSlot
                            x:Name="SignalAlpha" Width="196"
                            Height="82" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Opacity="0.12"
                            RenderTransform="scale(0.78) rotate(-8deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="1"/>
                          <motion:MotionSlot
                            x:Name="SignalBeta" Width="196"
                            Height="82" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Opacity="0.1"
                            RenderTransform="scale(0.72) rotate(7deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="1"/>
                          <motion:MotionSlot
                            x:Name="SignalGamma" Width="196"
                            Height="82" HorizontalAlignment="Center"
                            VerticalAlignment="Center" x:SetterTargetType="shadui:SmoothBorder"
                            Opacity="0.16" RenderTransform="scale(0.68) rotate(-5deg)"
                            RenderTransformOrigin="50%,50%" ZIndex="2">
                            <Setter Property="Background" Value="#4A0F172D"/>
                            <Setter Property="BorderBrush" Value="#48FFFFFF"/>
                            <Setter Property="CornerRadius" Value="18"/>
                            <motion:MotionSlot.TargetStyles>
                              <Style Selector="Grid#Header">
                                <Setter Property="Opacity" Value="1"/>
                              </Style>
                              <Style Selector="DockPanel#Details">
                                <Setter Property="Opacity" Value="0"/>
                              </Style>
                            </motion:MotionSlot.TargetStyles>
                          </motion:MotionSlot>
                          <motion:MotionSlot
                            x:Name="TimelineCore" Width="324"
                            Height="176" HorizontalAlignment="Center"
                            VerticalAlignment="Center" x:SetterTargetType="shadui:SmoothBorder"
                            Opacity="1" RenderTransform="scale(0.96) rotate(0deg)"
                            RenderTransformOrigin="50%,50%" ZIndex="4">
                            <Setter Property="Background" Value="#52121D3A"/>
                            <Setter Property="BorderBrush" Value="#6693C5FD"/>
                            <Setter Property="CornerRadius" Value="24"/>
                          </motion:MotionSlot>
                          <motion:MotionSlot
                            x:Name="TimelineStatus" Margin="0,0,0,12"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Opacity="0.88" ZIndex="5"/>
                        </Panel>
                      </DataTemplate>
                    </motion:TimelineMotionKeyFrame>

                    <!-- 1.4s CONSTELLATION -->
                    <motion:TimelineMotionKeyFrame
                      Easing="CubicEaseOut" KeyTime="0:0:1.4">
                      <DataTemplate>
                        <Grid
                          Margin="22" ColumnDefinitions="*,1.2*,*"
                          RowDefinitions="*,1.2*,*">
                          <motion:MotionSlot
                            x:Name="TimelineHalo" Grid.Row="0"
                            Grid.RowSpan="3" Grid.Column="0"
                            Grid.ColumnSpan="3" Width="360"
                            Height="360" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Opacity="0.78"
                            RenderTransform="scale(1) rotate(90deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="0"/>
                          <motion:MotionSlot
                            x:Name="SignalAlpha" Grid.Row="0"
                            Grid.Column="0" Width="204"
                            Height="82" Margin="6"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Opacity="1" RenderTransform="scale(1) rotate(-3deg)"
                            RenderTransformOrigin="50%,50%" ZIndex="1"/>
                          <motion:MotionSlot
                            x:Name="SignalBeta" Grid.Row="0"
                            Grid.Column="2" Width="204"
                            Height="82" Margin="6"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Opacity="1" RenderTransform="scale(1) rotate(4deg)"
                            RenderTransformOrigin="50%,50%" ZIndex="1"/>
                          <motion:MotionSlot
                            x:Name="SignalGamma" Grid.Row="2"
                            Grid.Column="1" Width="208"
                            Height="82" Margin="6"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            x:SetterTargetType="shadui:SmoothBorder" Opacity="1"
                            RenderTransform="scale(1) rotate(-2deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="2">
                            <Setter Property="Background" Value="#4C141432"/>
                            <Setter Property="BorderBrush" Value="#5CC084FC"/>
                            <Setter Property="CornerRadius" Value="18"/>
                            <motion:MotionSlot.TargetStyles>
                              <Style Selector="Grid#Header">
                                <Setter Property="Opacity" Value="1"/>
                              </Style>
                              <Style Selector="DockPanel#Details">
                                <Setter Property="Opacity" Value="0"/>
                              </Style>
                            </motion:MotionSlot.TargetStyles>
                          </motion:MotionSlot>
                          <motion:MotionSlot
                            x:Name="TimelineCore" Grid.Row="1"
                            Grid.Column="1" Width="320"
                            Height="172" HorizontalAlignment="Center"
                            VerticalAlignment="Center" x:SetterTargetType="shadui:SmoothBorder"
                            Opacity="1" RenderTransform="scale(1) rotate(0deg)"
                            RenderTransformOrigin="50%,50%" ZIndex="4">
                            <Setter Property="Background" Value="#54142244"/>
                            <Setter Property="BorderBrush" Value="#7093C5FD"/>
                            <Setter Property="CornerRadius" Value="22"/>
                          </motion:MotionSlot>
                          <motion:MotionSlot
                            x:Name="TimelineStatus" Grid.Row="2"
                            Grid.Column="2" Margin="6"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Opacity="1" ZIndex="5"/>
                        </Grid>
                      </DataTemplate>
                    </motion:TimelineMotionKeyFrame>

                    <!-- 3.2s STREAM -->
                    <motion:TimelineMotionKeyFrame
                      Easing="CubicEaseInOut" KeyTime="0:0:3.2">
                      <DataTemplate>
                        <Grid
                          Margin="22" ColumnDefinitions="1.35*,*"
                          ColumnSpacing="18" RowDefinitions="*,Auto"
                          RowSpacing="14">
                          <motion:MotionSlot
                            x:Name="TimelineHalo" Grid.Row="0"
                            Grid.RowSpan="2" Grid.Column="0"
                            Width="320" Height="320"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Opacity="0.56" RenderTransform="scale(1.06) rotate(180deg)"
                            RenderTransformOrigin="50%,50%" ZIndex="0"/>
                          <motion:MotionSlot
                            x:Name="TimelineCore" Grid.Row="0"
                            Grid.Column="0" Height="220"
                            Margin="6" VerticalAlignment="Center"
                            x:SetterTargetType="shadui:SmoothBorder" Opacity="1"
                            RenderTransform="scale(1) rotate(-1.5deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="4">
                            <Setter Property="Background" Value="#54182448"/>
                            <Setter Property="BorderBrush" Value="#6EA5B4FC"/>
                            <Setter Property="CornerRadius" Value="20"/>
                          </motion:MotionSlot>
                          <StackPanel
                            Grid.Row="0" Grid.Column="1"
                            VerticalAlignment="Center" Spacing="14"
                            ZIndex="1">
                            <motion:MotionSlot
                              x:Name="SignalAlpha" Height="88"
                              Opacity="1" RenderTransform="scale(1) rotate(0deg)"
                              RenderTransformOrigin="50%,50%" ZIndex="1"/>
                            <motion:MotionSlot
                              x:Name="SignalBeta" Height="88"
                              Opacity="1" RenderTransform="scale(1) rotate(0deg)"
                              RenderTransformOrigin="50%,50%" ZIndex="1"/>
                            <motion:MotionSlot
                              x:Name="SignalGamma" Height="88"
                              x:SetterTargetType="shadui:SmoothBorder" Opacity="1"
                              RenderTransform="scale(1) rotate(0deg)" RenderTransformOrigin="50%,50%"
                              ZIndex="2">
                              <Setter Property="Background" Value="#501D143B"/>
                              <Setter Property="BorderBrush" Value="#66C084FC"/>
                              <Setter Property="CornerRadius" Value="18"/>
                              <motion:MotionSlot.TargetStyles>
                                <Style Selector="Grid#Header">
                                  <Setter Property="Opacity" Value="1"/>
                                </Style>
                                <Style Selector="DockPanel#Details">
                                  <Setter Property="Opacity" Value="0"/>
                                </Style>
                              </motion:MotionSlot.TargetStyles>
                            </motion:MotionSlot>
                          </StackPanel>
                          <motion:MotionSlot
                            x:Name="TimelineStatus" Grid.Row="1"
                            Grid.Column="0" Grid.ColumnSpan="2"
                            HorizontalAlignment="Left" Opacity="1"
                            ZIndex="5"/>
                        </Grid>
                      </DataTemplate>
                    </motion:TimelineMotionKeyFrame>

                    <!-- 5.2s FOCUS -->
                    <motion:TimelineMotionKeyFrame
                      Easing="CubicEaseInOut" KeyTime="0:0:5.2">
                      <DataTemplate>
                        <Grid
                          Margin="22" ColumnDefinitions="0.9*,1.45*"
                          ColumnSpacing="18" RowDefinitions="*,*,*,Auto"
                          RowSpacing="12">
                          <motion:MotionSlot
                            x:Name="TimelineHalo" Grid.Row="0"
                            Grid.RowSpan="3" Grid.Column="1"
                            Width="350" Height="350"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Opacity="0.68" RenderTransform="scale(1.1) rotate(270deg)"
                            RenderTransformOrigin="50%,50%" ZIndex="0"/>
                          <motion:MotionSlot
                            x:Name="TimelineCore" Grid.Row="0"
                            Grid.Column="0" x:SetterTargetType="shadui:SmoothBorder"
                            Opacity="0.92" RenderTransform="scale(0.98) rotate(0deg)"
                            RenderTransformOrigin="50%,50%" ZIndex="4">
                            <Setter Property="Background" Value="#48141E36"/>
                            <Setter Property="BorderBrush" Value="#48FFFFFF"/>
                            <Setter Property="CornerRadius" Value="18"/>
                          </motion:MotionSlot>
                          <motion:MotionSlot
                            x:Name="SignalAlpha" Grid.Row="1"
                            Grid.Column="0" Opacity="0.86"
                            RenderTransform="scale(0.98) rotate(0deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="1"/>
                          <motion:MotionSlot
                            x:Name="SignalBeta" Grid.Row="2"
                            Grid.Column="0" Opacity="0.78"
                            RenderTransform="scale(0.96) rotate(0deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="1"/>
                          <motion:MotionSlot
                            x:Name="SignalGamma" Grid.Row="0"
                            Grid.RowSpan="3" Grid.Column="1"
                            Margin="4" x:SetterTargetType="shadui:SmoothBorder"
                            Opacity="1" RenderTransform="scale(1) rotate(0deg)"
                            RenderTransformOrigin="50%,50%" ZIndex="3">
                            <Setter Property="Background" Value="#5C28144B"/>
                            <Setter Property="BorderBrush" Value="#80D8B4FE"/>
                            <Setter Property="CornerRadius" Value="24"/>
                            <motion:MotionSlot.TargetStyles>
                              <Style Selector="Grid#Header">
                                <Setter Property="Opacity" Value="0"/>
                              </Style>
                              <Style Selector="DockPanel#Details">
                                <Setter Property="Opacity" Value="1"/>
                              </Style>
                            </motion:MotionSlot.TargetStyles>
                          </motion:MotionSlot>
                          <motion:MotionSlot
                            x:Name="TimelineStatus" Grid.Row="3"
                            Grid.Column="0" Grid.ColumnSpan="2"
                            HorizontalAlignment="Right" Opacity="1"
                            ZIndex="5"/>
                        </Grid>
                      </DataTemplate>
                    </motion:TimelineMotionKeyFrame>

                    <!-- 7.0s SEED (Closed Loop) -->
                    <motion:TimelineMotionKeyFrame
                      Easing="CubicEaseInOut" KeyTime="0:0:7">
                      <DataTemplate>
                        <Panel Margin="20">
                          <motion:MotionSlot
                            x:Name="TimelineHalo" Width="280"
                            Height="280" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Opacity="0.45"
                            RenderTransform="scale(0.76) rotate(360deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="0"/>
                          <motion:MotionSlot
                            x:Name="SignalAlpha" Width="196"
                            Height="82" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Opacity="0.12"
                            RenderTransform="scale(0.78) rotate(-8deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="1"/>
                          <motion:MotionSlot
                            x:Name="SignalBeta" Width="196"
                            Height="82" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Opacity="0.1"
                            RenderTransform="scale(0.72) rotate(7deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="1"/>
                          <motion:MotionSlot
                            x:Name="SignalGamma" Width="196"
                            Height="82" HorizontalAlignment="Center"
                            VerticalAlignment="Center" x:SetterTargetType="shadui:SmoothBorder"
                            Opacity="0.16" RenderTransform="scale(0.68) rotate(-5deg)"
                            RenderTransformOrigin="50%,50%" ZIndex="2">
                            <Setter Property="Background" Value="#4A0F172D"/>
                            <Setter Property="BorderBrush" Value="#48FFFFFF"/>
                            <Setter Property="CornerRadius" Value="18"/>
                            <motion:MotionSlot.TargetStyles>
                              <Style Selector="Grid#Header">
                                <Setter Property="Opacity" Value="1"/>
                              </Style>
                              <Style Selector="DockPanel#Details">
                                <Setter Property="Opacity" Value="0"/>
                              </Style>
                            </motion:MotionSlot.TargetStyles>
                          </motion:MotionSlot>
                          <motion:MotionSlot
                            x:Name="TimelineCore" Width="324"
                            Height="176" HorizontalAlignment="Center"
                            VerticalAlignment="Center" x:SetterTargetType="shadui:SmoothBorder"
                            Opacity="1" RenderTransform="scale(0.96) rotate(0deg)"
                            RenderTransformOrigin="50%,50%" ZIndex="4">
                            <Setter Property="Background" Value="#52121D3A"/>
                            <Setter Property="BorderBrush" Value="#6693C5FD"/>
                            <Setter Property="CornerRadius" Value="24"/>
                          </motion:MotionSlot>
                          <motion:MotionSlot
                            x:Name="TimelineStatus" Margin="0,0,0,12"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Opacity="0.88" ZIndex="5"/>
                        </Panel>
                      </DataTemplate>
                    </motion:TimelineMotionKeyFrame>
                  </motion:TimelineMotion>
                </motion:MotionPanel.Motion>

                <Border
                  x:Name="TimelineHalo" Background="#0D7CA8FF"
                  BorderBrush="#6693C5FD" BorderThickness="1"
                  CornerRadius="999">
                  <Border
                    Margin="28" BorderBrush="#48D8B4FE"
                    BorderThickness="1" CornerRadius="999"/>
                </Border>

                <shadui:SmoothBorder
                  x:Name="TimelineCore" Classes="TimelineTile">
                  <Border
                    Padding="18" BackdropEffect="blur(24)" BackdropEffectCache="Volatile"
                    Background="Transparent">
                    <Grid
                      ColumnDefinitions="Auto,*" ColumnSpacing="12"
                      RowDefinitions="Auto,*,Auto" RowSpacing="10">
                      <shadui:SmoothBorder
                        Grid.Row="0" Grid.Column="0"
                        Width="38" Height="38"
                        Background="#523B82F6" BorderBrush="#6693C5FD"
                        BorderThickness="1" CornerRadius="12"
                        CornerSmoothing="0.6">
                        <tabler:TablerIcon
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="White" Kind="Sparkles"
                          Size="19" StrokeWidth="1.9"/>
                      </shadui:SmoothBorder>
                      <StackPanel
                        Grid.Row="0" Grid.Column="1"
                        VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                          Classes="TimelineKicker" Text="MOTION CORE"/>
                        <TextBlock
                          FontSize="18" FontWeight="SemiBold"
                          Foreground="White" Text="Constellation"/>
                      </StackPanel>
                      <TextBlock
                        Classes="TimelineBody" Grid.Row="1"
                        Grid.Column="0" Grid.ColumnSpan="2"
                        VerticalAlignment="Center"
                        Text="One stable visual identity, authored across absolute key times."/>
                      <Grid
                        Grid.Row="2" Grid.Column="0"
                        Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                        <Border
                          Grid.Column="0" Height="4"
                          VerticalAlignment="Center" Background="#38FFFFFF"
                          CornerRadius="2">
                          <Border
                            Width="96" HorizontalAlignment="Left"
                            Background="#FF7DD3FC" CornerRadius="2"/>
                        </Border>
                        <TextBlock
                          Classes="TimelineKicker" Grid.Column="1"
                          Margin="12,0,0,0" Text="FRAME SYNC"/>
                      </Grid>
                    </Grid>
                  </Border>
                </shadui:SmoothBorder>

                <shadui:SmoothBorder
                  x:Name="SignalAlpha" Classes="TimelineSignal">
                  <Border
                    Padding="14,12" BackdropEffect="blur(24)" BackdropEffectCache="Volatile"
                    Background="Transparent">
                    <Grid
                      VerticalAlignment="Center" ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">
                      <shadui:SmoothBorder
                        Width="36" Height="36"
                        Background="#3838BDF8" BorderBrush="#527DD3FC"
                        BorderThickness="1" CornerRadius="11"
                        CornerSmoothing="0.6">
                        <tabler:TablerIcon
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="#FFBAE6FD" Kind="Radio"
                          Size="18" StrokeWidth="1.9"/>
                      </shadui:SmoothBorder>
                      <StackPanel
                        Grid.Column="1" VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                          Classes="TimelineKicker" Text="SIGNAL A"/>
                        <TextBlock
                          FontSize="15" FontWeight="SemiBold"
                          Foreground="White" Text="Position"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </shadui:SmoothBorder>

                <shadui:SmoothBorder
                  x:Name="SignalBeta" Classes="TimelineSignal">
                  <Border
                    Padding="14,12" BackdropEffect="blur(24)" BackdropEffectCache="Volatile"
                    Background="Transparent">
                    <Grid
                      VerticalAlignment="Center" ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">
                      <shadui:SmoothBorder
                        Width="36" Height="36"
                        Background="#3810B981" BorderBrush="#526EE7B7"
                        BorderThickness="1" CornerRadius="11"
                        CornerSmoothing="0.6">
                        <tabler:TablerIcon
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="#FFA7F3D0" Kind="Activity"
                          Size="18" StrokeWidth="1.9"/>
                      </shadui:SmoothBorder>
                      <StackPanel
                        Grid.Column="1" VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                          Classes="TimelineKicker" Text="SIGNAL B"/>
                        <TextBlock
                          FontSize="15" FontWeight="SemiBold"
                          Foreground="White" Text="Transform"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </shadui:SmoothBorder>

                <shadui:SmoothBorder
                  x:Name="SignalGamma" Classes="TimelineSignal">
                  <Border
                    Padding="14,12" BackdropEffect="blur(24)" BackdropEffectCache="Volatile"
                    Background="Transparent">
                    <Panel>
                      <Grid
                        x:Name="Header" VerticalAlignment="Center"
                        ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <shadui:SmoothBorder
                          Width="36" Height="36"
                          Background="#40A855F7" BorderBrush="#66D8B4FE"
                          BorderThickness="1" CornerRadius="11"
                          CornerSmoothing="0.6">
                          <tabler:TablerIcon
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Foreground="#FFF3E8FF" Kind="Bolt"
                            Size="18" StrokeWidth="1.9"/>
                        </shadui:SmoothBorder>
                        <StackPanel
                          Grid.Column="1" VerticalAlignment="Center"
                          Spacing="2">
                          <TextBlock
                            Classes="TimelineKicker" Text="SIGNAL C"/>
                          <TextBlock
                            FontSize="15" FontWeight="SemiBold"
                            Foreground="White" Text="Property"/>
                        </StackPanel>
                      </Grid>

                      <DockPanel
                        x:Name="Details" Margin="10"
                        ClipToBounds="True" Opacity="0">
                        <StackPanel
                          DockPanel.Dock="Bottom" Margin="0,12,0,0"
                          Orientation="Horizontal" Spacing="8">
                          <shadui:SmoothBorder
                            Padding="10,5" Background="#3DA855F7"
                            BorderBrush="#5CD8B4FE" BorderThickness="1"
                            CornerRadius="10" CornerSmoothing="0.6">
                            <TextBlock
                              Classes="TimelineKicker" Foreground="#FFF3E8FF"
                              Text="LAYOUT"/>
                          </shadui:SmoothBorder>
                          <shadui:SmoothBorder
                            Padding="10,5" Background="#3DA855F7"
                            BorderBrush="#5CD8B4FE" BorderThickness="1"
                            CornerRadius="10" CornerSmoothing="0.6">
                            <TextBlock
                              Classes="TimelineKicker" Foreground="#FFF3E8FF"
                              Text="TRANSFORM"/>
                          </shadui:SmoothBorder>
                          <shadui:SmoothBorder
                            Padding="10,5" Background="#3DA855F7"
                            BorderBrush="#5CD8B4FE" BorderThickness="1"
                            CornerRadius="10" CornerSmoothing="0.6">
                            <TextBlock
                              Classes="TimelineKicker" Foreground="#FFF3E8FF"
                              Text="STYLE"/>
                          </shadui:SmoothBorder>
                        </StackPanel>

                        <StackPanel
                          VerticalAlignment="Center" Spacing="12">
                          <StackPanel
                            Orientation="Horizontal" Spacing="8">
                            <shadui:SmoothBorder
                              Width="28" Height="28"
                              Background="#45A855F7" BorderBrush="#66D8B4FE"
                              BorderThickness="1" CornerRadius="8"
                              CornerSmoothing="0.6">
                              <tabler:TablerIcon
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Foreground="#FFF3E8FF" Kind="Bolt"
                                Size="15" StrokeWidth="2"/>
                            </shadui:SmoothBorder>
                            <TextBlock
                              Classes="TimelineKicker" VerticalAlignment="Center"
                              Foreground="#FFE9D5FF" Text="SIGNAL C · PROPERTY FOCUS"/>
                          </StackPanel>

                          <SelectableTextBlock
                            MaxWidth="420" HorizontalAlignment="Left"
                            FontSize="24" FontWeight="SemiBold"
                            Foreground="White" Text="One timeline. Every property."
                            TextWrapping="Wrap"/>

                          <SelectableTextBlock
                            MaxWidth="420" HorizontalAlignment="Left"
                            FontSize="13.5" Foreground="#E8DFF7FF"
                            LineHeight="21" Text="Layout bounds, opacity, brushes, corners, and transforms are sampled through one interpolation pipeline while the real control keeps its identity."
                            TextWrapping="Wrap"/>
                        </StackPanel>
                      </DockPanel>
                    </Panel>
                  </Border>
                </shadui:SmoothBorder>

                <shadui:SmoothBorder
                  x:Name="TimelineStatus" Background="Transparent"
                  BackgroundSizing="InnerBorderEdge" BorderBrush="#48FFFFFF"
                  BorderThickness="1" ClipToBounds="True"
                  CornerRadius="16" CornerSmoothing="0.6">
                  <Border
                    Padding="12,7" BackdropEffect="blur(24)" BackdropEffectCache="Volatile"
                    Background="#5C0D1426">
                    <StackPanel
                      Orientation="Horizontal" Spacing="8">
                      <Border
                        Width="8" Height="8"
                        VerticalAlignment="Center" Background="#FF6EE7B7"
                        CornerRadius="4"/>
                      <TextBlock
                        Classes="TimelineKicker" VerticalAlignment="Center"
                        Foreground="#F0F5FAFF" Text="LIVE LAYOUT · NO SNAPSHOTS"/>
                    </StackPanel>
                  </Border>
                </shadui:SmoothBorder>
              </motion:MotionPanel>
            </Panel>
          </shadui:SmoothBorder>
        </StackPanel>
      </controls:DemoExample>
    </StackPanel>
  </ScrollViewer>
</UserControl>
