<!--  ReSharper disable Xaml.RedundantResource  -->
<UserControl
  x:Class="Motion.Avalonia.Demo.Views.KeyFrameMotionPage" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Motion.Avalonia.Demo.Controls"
  xmlns:converters="using:Motion.Avalonia.Demo.Converters" xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
  xmlns:motion="using:Motion.Avalonia" xmlns:shadui="clr-namespace:ShadUI.Controls;assembly=ShadUI">
  <UserControl.Styles>
    <Style Selector="Border.TimelineTile">
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Background" Value="#FF172033"/>
      <Setter Property="BorderBrush" Value="#FF33415F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="0 12 32 0 #3D000000"/>
      <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <Style Selector="Border.TimelineSignal">
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Background" Value="#FF151D2D"/>
      <Setter Property="BorderBrush" Value="#FF34415A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="0 8 24 0 #33000000"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="TextBlock.TimelineKicker">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#FF91A4C5"/>
    </Style>

    <Style Selector="TextBlock.TimelineBody">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#FF9CAAC2"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel
      MaxWidth="{StaticResource DemoPageMaxWidth}"
      Margin="{StaticResource DemoPageMargin}"
      HorizontalAlignment="Stretch" Spacing="32">
      <StackPanel Spacing="8">
        <TextBlock
          Classes="DemoEyebrow" Text="KEYFRAME MOTION"/>
        <TextBlock
          Classes="DemoTitle" Text="Sample progress or author time."/>
        <TextBlock
          Classes="DemoDescription" MaxWidth="768"
          HorizontalAlignment="Left" Text="SequenceMotion samples externally supplied progress, while TimelineMotion evaluates authored times and exposes a frame-aligned player. Each property follows only the keyframes that explicitly author it."/>
      </StackPanel>

      <controls:DemoExample
        Title="Externally driven progress sequence" HorizontalContentAlignment="Stretch"
        Description="SequenceMotion has no player. Drag the Slider to supply Progress directly and sample four declarative Cue keyframes in either direction.">
        <StackPanel Spacing="16">
          <Slider
            x:Name="SequenceSlider" LargeChange="0.1"
            Maximum="1" Minimum="0"
            SmallChange="0.01" TickFrequency="0.3333333333333333"
            ValueChanged="OnSequenceSliderValueChanged"/>

          <UniformGrid Columns="4">
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="ORBIT"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="COLUMNS" TextAlignment="Center"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="FOCUS" TextAlignment="Center"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="STACK" TextAlignment="Right"/>
          </UniformGrid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock
              x:Name="SequenceFrameLabel" Grid.Column="0"
              FontWeight="SemiBold" Text="Orbit"/>
            <TextBlock
              Grid.Column="1" FontFamily="Cascadia Mono,Consolas"
              Foreground="{DynamicResource MutedColor}"
              Text="{Binding #SequenceSlider.Value, StringFormat='Progress \{0:0.00\}'}"/>
          </Grid>

          <Border
            Height="400" Padding="16"
            Background="{DynamicResource WindowBackgroundColor}"
            CornerRadius="8">
            <motion:MotionPanel ClipToBounds="True">
              <motion:MotionPanel.Motion>
                <motion:SequenceMotion Progress="{Binding #SequenceSlider.Value}">
                  <motion:SequenceMotionKeyFrame Cue="0%">
                    <DataTemplate>
                      <UniformGrid
                        Columns="2" Rows="2">
                        <motion:MotionSlot
                          x:Name="AlphaTile" Margin="8"/>
                        <motion:MotionSlot
                          x:Name="BetaTile" Margin="8"/>
                        <motion:MotionSlot
                          x:Name="GammaTile" Margin="8"/>
                        <motion:MotionSlot
                          x:Name="DeltaTile" Margin="8"/>
                      </UniformGrid>
                    </DataTemplate>
                  </motion:SequenceMotionKeyFrame>
                  <motion:SequenceMotionKeyFrame Cue="33.33333333333333%">
                    <DataTemplate>
                      <UniformGrid Columns="4">
                        <motion:MotionSlot
                          x:Name="AlphaTile" Margin="8"/>
                        <motion:MotionSlot
                          x:Name="BetaTile" Margin="8"/>
                        <motion:MotionSlot
                          x:Name="GammaTile" Margin="8"/>
                        <motion:MotionSlot
                          x:Name="DeltaTile" Margin="8"/>
                      </UniformGrid>
                    </DataTemplate>
                  </motion:SequenceMotionKeyFrame>
                  <motion:SequenceMotionKeyFrame Cue="66.66666666666666%">
                    <DataTemplate>
                      <Grid
                        ColumnDefinitions="2*,*" ColumnSpacing="8">
                        <motion:MotionSlot
                          x:Name="AlphaTile" Grid.Column="0"
                          Margin="8"/>
                        <UniformGrid
                          Grid.Column="1" Rows="3">
                          <motion:MotionSlot
                            x:Name="BetaTile" Margin="8"/>
                          <motion:MotionSlot
                            x:Name="GammaTile" Margin="8"/>
                          <motion:MotionSlot
                            x:Name="DeltaTile" Margin="8"/>
                        </UniformGrid>
                      </Grid>
                    </DataTemplate>
                  </motion:SequenceMotionKeyFrame>
                  <motion:SequenceMotionKeyFrame Cue="100%">
                    <DataTemplate>
                      <UniformGrid Rows="4">
                        <motion:MotionSlot
                          x:Name="AlphaTile" Margin="8"/>
                        <motion:MotionSlot
                          x:Name="BetaTile" Margin="8"/>
                        <motion:MotionSlot
                          x:Name="GammaTile" Margin="8"/>
                        <motion:MotionSlot
                          x:Name="DeltaTile" Margin="8"/>
                      </UniformGrid>
                    </DataTemplate>
                  </motion:SequenceMotionKeyFrame>
                </motion:SequenceMotion>
              </motion:MotionPanel.Motion>

              <Border
                x:Name="AlphaTile" Padding="16"
                Background="#FF32577A" CornerRadius="12">
                <StackPanel Spacing="4">
                  <TextBlock
                    FontSize="20" FontWeight="SemiBold"
                    Text="Alpha"/>
                  <TextBlock
                    Text="Stable control, changing bounds." TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border
                x:Name="BetaTile" Padding="16"
                Background="#FF62406F" CornerRadius="12">
                <StackPanel Spacing="4">
                  <TextBlock
                    FontSize="20" FontWeight="SemiBold"
                    Text="Beta"/>
                  <TextBlock
                    Text="Driven by continuous progress." TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border
                x:Name="GammaTile" Padding="16"
                Background="#FF48664B" CornerRadius="12">
                <StackPanel Spacing="4">
                  <TextBlock
                    FontSize="20" FontWeight="SemiBold"
                    Text="Gamma"/>
                  <TextBlock
                    Text="Seekable in either direction." TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border
                x:Name="DeltaTile" Padding="16"
                Background="#FF78502F" CornerRadius="12">
                <StackPanel Spacing="4">
                  <TextBlock
                    FontSize="20" FontWeight="SemiBold"
                    Text="Delta"/>
                  <TextBlock
                    Text="No clock belongs to the panel." TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </motion:MotionPanel>
          </Border>
        </StackPanel>
      </controls:DemoExample>

      <controls:DemoExample
        Title="Authored timeline and player transport" HorizontalContentAlignment="Stretch"
        Description="TimelineMotion evaluates absolute KeyTime values. Scrub at any moment, pause and resume its player, or enable Loop to replay this closed keyframe sequence.">
        <StackPanel Spacing="16">
          <Grid
            ColumnDefinitions="40,*,Auto,Auto" ColumnSpacing="12">
            <Grid
              Grid.Column="0" Width="40"
              Height="40">
              <Button
                Classes="Primary Compact Uniform Rounded"
                shadui:ButtonAssist.Icon="{LucideIconContent Play}"
                shadui:ButtonAssist.IconSize="16"
                Command="{Binding #TimelineMotion.Player.Play}"
                IsVisible="{Binding #TimelineMotion.Player.State, Converter={x:Static converters:MotionConverters.IsNotPlaying}}"
                ToolTip.Tip="Play or resume"/>
              <Button
                Classes="Primary Compact Uniform Rounded"
                shadui:ButtonAssist.Icon="{LucideIconContent Pause}"
                shadui:ButtonAssist.IconSize="16"
                Command="{Binding #TimelineMotion.Player.Pause}"
                IsVisible="{Binding #TimelineMotion.Player.State, Converter={x:Static converters:MotionConverters.IsPlaying}}"
                ToolTip.Tip="Pause"/>
            </Grid>
            <Slider
              Grid.Column="1" VerticalAlignment="Center"
              LargeChange="0.5"
              Maximum="{Binding #TimelineMotion.Duration, Converter={x:Static converters:MotionConverters.TimeSpanSeconds}}"
              Minimum="0" SmallChange="0.1"
              TickFrequency="1"
              Value="{Binding #TimelineMotion.Time, Mode=TwoWay, Converter={x:Static converters:MotionConverters.TimeSpanSeconds}}"/>
            <TextBlock
              Grid.Column="2" MinWidth="96"
              VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas"
              Foreground="{DynamicResource MutedColor}">
              <Run Text="{Binding #TimelineMotion.Time, Converter={x:Static converters:MotionConverters.TimelineTimestamp}}"/>
              <Run Text="/"/>
              <Run Text="{Binding #TimelineMotion.Duration, Converter={x:Static converters:MotionConverters.TimelineTimestamp}}"/>
            </TextBlock>
            <CheckBox
              Grid.Column="3" VerticalAlignment="Center"
              Content="Loop"
              IsChecked="{Binding #TimelineMotion.Loop, Mode=TwoWay}"/>
          </Grid>

          <UniformGrid Columns="5">
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="SEED · 0.0"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="CONSTELLATION · 1.4" TextAlignment="Center"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="STREAM · 3.2" TextAlignment="Center"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="FOCUS · 5.2" TextAlignment="Center"/>
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource MutedColor}"
              Text="SEED · 7.0" TextAlignment="Right"/>
          </UniformGrid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock
              x:Name="TimelineFrameLabel" Grid.Column="0"
              FontWeight="SemiBold" Text="Seed"/>
            <TextBlock
              Grid.Column="1"
              Foreground="{DynamicResource MutedColor}"
              Text="Destination keyframes own easing"/>
          </Grid>

          <Border
            Height="472" Background="#FF080D18"
            BorderBrush="#FF27334A" BorderThickness="1"
            ClipToBounds="True" CornerRadius="12">
            <motion:MotionPanel ClipToBounds="True">
              <motion:MotionPanel.Motion>
                <motion:TimelineMotion x:Name="TimelineMotion">
                  <motion:TimelineMotionKeyFrame KeyTime="0:0:0">
                    <DataTemplate>
                      <Panel Margin="16">
                        <motion:MotionSlot
                          x:Name="TimelineHalo" Width="280"
                          Height="280" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Opacity="0.32"
                          RenderTransform="scale(0.72) rotate(0deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="0"/>
                        <motion:MotionSlot
                          x:Name="SignalAlpha" Width="168"
                          Height="96" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Opacity="0.12"
                          RenderTransform="scale(0.72) rotate(-10deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="1"/>
                        <motion:MotionSlot
                          x:Name="SignalBeta" Width="168"
                          Height="96" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Opacity="0.08"
                          RenderTransform="scale(0.64) rotate(8deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="1"/>
                        <motion:MotionSlot
                          x:Name="SignalGamma" Width="168"
                          Height="96" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Opacity="0.9"
                          RenderTransform="scale(0.56) rotate(-6deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="2">
                          <motion:MotionSlot.TargetStyles>
                            <Style Selector="DockPanel#Header">
                              <Setter Property="Opacity" Value="1"/>
                            </Style>
                            <Style Selector="DockPanel#Details">
                              <Setter Property="Opacity" Value="0"/>
                            </Style>
                          </motion:MotionSlot.TargetStyles>
                        </motion:MotionSlot>
                        <motion:MotionSlot
                          x:Name="TimelineCore" Width="288"
                          Height="160" HorizontalAlignment="Center"
                          VerticalAlignment="Center" x:SetterTargetType="Border"
                          Opacity="0.9" RenderTransform="scale(0.92) rotate(0deg)"
                          RenderTransformOrigin="50%,50%" ZIndex="4">
                          <Setter Property="Background" Value="#FF1D2A46"/>
                          <Setter Property="BorderBrush" Value="#FF5277B7"/>
                          <Setter Property="CornerRadius" Value="28"/>
                        </motion:MotionSlot>
                        <motion:MotionSlot
                          x:Name="TimelineStatus" Margin="0,0,0,16"
                          HorizontalAlignment="Center" VerticalAlignment="Bottom"
                          Opacity="0.72" ZIndex="5"/>
                      </Panel>
                    </DataTemplate>
                  </motion:TimelineMotionKeyFrame>

                  <motion:TimelineMotionKeyFrame
                    Easing="CubicEaseOut" KeyTime="0:0:1.4">
                    <DataTemplate>
                      <Grid
                        Margin="16" ColumnDefinitions="*,1.1*,*"
                        RowDefinitions="*,1.1*,*">
                        <motion:MotionSlot
                          x:Name="TimelineHalo" Grid.Row="0"
                          Grid.RowSpan="3" Grid.Column="0"
                          Grid.ColumnSpan="3" Margin="56"
                          Opacity="0.72" RenderTransform="scale(1) rotate(90deg)"
                          RenderTransformOrigin="50%,50%" ZIndex="0"/>
                        <motion:MotionSlot
                          x:Name="SignalAlpha" Grid.Row="0"
                          Grid.Column="0" Width="168"
                          Height="96" Margin="8"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          RenderTransform="scale(1) rotate(-4deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="1">
                          <Setter x:SetterTargetType="Border" Property="Padding" Value="0"/>
                        </motion:MotionSlot>
                        <motion:MotionSlot
                          x:Name="SignalBeta" Grid.Row="0"
                          Grid.Column="2" Width="168"
                          Height="96" Margin="8"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          RenderTransform="scale(1) rotate(5deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="1">
                          <Setter x:SetterTargetType="Border" Property="Padding" Value="0"/>
                        </motion:MotionSlot>
                        <motion:MotionSlot
                          x:Name="SignalGamma" Grid.Row="2"
                          Grid.Column="1" Width="168"
                          Height="96" Margin="8"
                          HorizontalAlignment="Center" VerticalAlignment="Bottom"
                          Opacity="0.9" RenderTransform="scale(1) rotate(-2deg)"
                          RenderTransformOrigin="50%,50%" ZIndex="2">
                          <Setter x:SetterTargetType="Border" Property="Padding" Value="0"/>
                          <motion:MotionSlot.TargetStyles>
                            <Style Selector="DockPanel#Header">
                              <Setter Property="Opacity" Value="1"/>
                            </Style>
                            <Style Selector="DockPanel#Details">
                              <Setter Property="Opacity" Value="0"/>
                            </Style>
                          </motion:MotionSlot.TargetStyles>
                        </motion:MotionSlot>
                        <motion:MotionSlot
                          x:Name="TimelineCore" Grid.Row="1"
                          Grid.Column="1" Margin="8"
                          x:SetterTargetType="Border" Opacity="0.9"
                          RenderTransform="scale(1) rotate(0deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="4">
                          <Setter Property="Background" Value="#FF202E50"/>
                          <Setter Property="BorderBrush" Value="#FF6B8ED0"/>
                          <Setter Property="CornerRadius" Value="20"/>
                        </motion:MotionSlot>
                        <motion:MotionSlot
                          x:Name="TimelineStatus" Grid.Row="2"
                          Grid.Column="2" Margin="8"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          ZIndex="5"/>
                      </Grid>
                    </DataTemplate>
                  </motion:TimelineMotionKeyFrame>

                  <motion:TimelineMotionKeyFrame
                    Easing="CubicEaseInOut" KeyTime="0:0:3.2">
                    <DataTemplate>
                      <Grid
                        Margin="16" ColumnDefinitions="1.45*,*"
                        ColumnSpacing="12" RowDefinitions="*,Auto"
                        RowSpacing="12">
                        <motion:MotionSlot
                          x:Name="TimelineHalo" Grid.Row="0"
                          Grid.RowSpan="2" Grid.Column="0"
                          Margin="24" Opacity="0.48"
                          RenderTransform="scale(1.08) rotate(180deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="0"/>
                        <motion:MotionSlot
                          x:Name="TimelineCore" Grid.Row="0"
                          Grid.Column="0" Margin="16"
                          x:SetterTargetType="Border" Opacity="0.9"
                          RenderTransform="scale(1) rotate(-2deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="4">
                          <Setter Property="Background" Value="#FF273251"/>
                          <Setter Property="BorderBrush" Value="#FF7891C6"/>
                          <Setter Property="CornerRadius" Value="16"/>
                        </motion:MotionSlot>
                        <UniformGrid
                          Grid.Row="0" Grid.Column="1"
                          Margin="4" VerticalAlignment="Center"
                          RowSpacing="12" Rows="3"
                          ZIndex="1">
                          <motion:MotionSlot
                            x:Name="SignalAlpha" Height="96"
                            RenderTransform="scale(1) rotate(0deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="1">
                            <Setter x:SetterTargetType="Border" Property="Padding" Value="0,12,128,12"/>
                          </motion:MotionSlot>
                          <motion:MotionSlot
                            x:Name="SignalBeta" Height="96"
                            RenderTransform="scale(1) rotate(0deg)" RenderTransformOrigin="50%,50%"
                            ZIndex="1">
                            <Setter x:SetterTargetType="Border" Property="Padding" Value="0,12,110,12"/>
                          </motion:MotionSlot>
                          <motion:MotionSlot
                            x:Name="SignalGamma" Height="96"
                            Opacity="0.9" RenderTransform="scale(1) rotate(0deg)"
                            RenderTransformOrigin="50%,50%" ZIndex="2">
                            <motion:MotionSlot.TargetStyles>
                              <Style Selector="DockPanel#Header">
                                <Setter Property="Opacity" Value="1"/>
                              </Style>
                              <Style Selector="DockPanel#Details">
                                <Setter Property="Opacity" Value="0"/>
                              </Style>
                            </motion:MotionSlot.TargetStyles>
                            <Setter x:SetterTargetType="Border" Property="Padding" Value="0,12,128,12"/>
                          </motion:MotionSlot>
                        </UniformGrid>
                        <motion:MotionSlot
                          x:Name="TimelineStatus" Grid.Row="1"
                          Grid.Column="0" Grid.ColumnSpan="2"
                          HorizontalAlignment="Left" ZIndex="5"/>
                      </Grid>
                    </DataTemplate>
                  </motion:TimelineMotionKeyFrame>

                  <motion:TimelineMotionKeyFrame
                    Easing="CubicEaseInOut" KeyTime="0:0:5.2">
                    <DataTemplate>
                      <Grid
                        Margin="16" ColumnDefinitions="0.8*,1.6*"
                        ColumnSpacing="12" RowDefinitions="*,*,*,Auto"
                        RowSpacing="12">
                        <motion:MotionSlot
                          x:Name="TimelineHalo" Grid.Row="0"
                          Grid.RowSpan="3" Grid.Column="1"
                          Margin="32" Opacity="0.64"
                          RenderTransform="scale(1.12) rotate(270deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="0"/>
                        <motion:MotionSlot
                          x:Name="TimelineCore" Grid.Row="0"
                          Grid.Column="0" Margin="4"
                          x:SetterTargetType="Border" Opacity="0.9"
                          RenderTransform="scale(0.96) rotate(-2deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="4">
                          <Setter Property="Background" Value="#FF242C44"/>
                          <Setter Property="BorderBrush" Value="#FF566783"/>
                          <Setter Property="CornerRadius" Value="12"/>
                        </motion:MotionSlot>
                        <motion:MotionSlot
                          x:Name="SignalAlpha" Grid.Row="1"
                          Grid.Column="0" Margin="4"
                          Opacity="0.82" RenderTransform="scale(0.96) rotate(0deg)"
                          RenderTransformOrigin="50%,50%" ZIndex="1">
                          <Setter x:SetterTargetType="Border" Property="Padding" Value="0"/>
                        </motion:MotionSlot>
                        <motion:MotionSlot
                          x:Name="SignalBeta" Grid.Row="2"
                          Grid.Column="0" Margin="4"
                          Opacity="0.64" RenderTransform="scale(0.92) rotate(0deg)"
                          RenderTransformOrigin="50%,50%" ZIndex="1">
                          <Setter x:SetterTargetType="Border" Property="Padding" Value="0"/>
                        </motion:MotionSlot>
                        <motion:MotionSlot
                          x:Name="SignalGamma" Grid.Row="0"
                          Grid.RowSpan="3" Grid.Column="1"
                          Margin="16" x:SetterTargetType="Border"
                          Opacity="0.9" RenderTransform="scale(1.04) rotate(2deg)"
                          RenderTransformOrigin="50%,50%" ZIndex="2">
                          <Setter x:SetterTargetType="Border" Property="Padding" Value="0"/>
                          <motion:MotionSlot.TargetStyles>
                            <Style Selector="DockPanel#Header">
                              <Setter Property="Opacity" Value="0"/>
                              <Setter Property="RenderTransform" Value="scale(3)"/>
                            </Style>
                            <Style Selector="DockPanel#Details">
                              <Setter Property="Opacity" Value="1"/>
                            </Style>
                          </motion:MotionSlot.TargetStyles>
                          <Setter Property="Background" Value="#FF3B2852"/>
                          <Setter Property="BorderBrush" Value="#FF9D6DCF"/>
                          <Setter Property="CornerRadius" Value="24"/>
                        </motion:MotionSlot>
                        <motion:MotionSlot
                          x:Name="TimelineStatus" Grid.Row="3"
                          Grid.Column="0" Grid.ColumnSpan="2"
                          HorizontalAlignment="Right" ZIndex="5"/>
                      </Grid>
                    </DataTemplate>
                  </motion:TimelineMotionKeyFrame>

                  <motion:TimelineMotionKeyFrame
                    Easing="CubicEaseInOut" KeyTime="0:0:7">
                    <DataTemplate>
                      <Panel Margin="16">
                        <motion:MotionSlot
                          x:Name="TimelineHalo" Width="280"
                          Height="280" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Opacity="0.32"
                          RenderTransform="scale(0.72) rotate(0deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="0"/>
                        <motion:MotionSlot
                          x:Name="SignalAlpha" Width="168"
                          Height="96" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Opacity="0.12"
                          RenderTransform="scale(0.72) rotate(-10deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="1"/>
                        <motion:MotionSlot
                          x:Name="SignalBeta" Width="168"
                          Height="96" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Opacity="0.08"
                          RenderTransform="scale(0.64) rotate(8deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="1"/>
                        <motion:MotionSlot
                          x:Name="SignalGamma" Width="168"
                          Height="96" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Opacity="0.9"
                          RenderTransform="scale(0.56) rotate(-6deg)" RenderTransformOrigin="50%,50%"
                          ZIndex="2">
                          <motion:MotionSlot.TargetStyles>
                            <Style Selector="DockPanel#Header">
                              <Setter Property="Opacity" Value="1"/>
                            </Style>
                            <Style Selector="DockPanel#Details">
                              <Setter Property="Opacity" Value="0"/>
                            </Style>
                          </motion:MotionSlot.TargetStyles>
                        </motion:MotionSlot>
                        <motion:MotionSlot
                          x:Name="TimelineCore" Width="288"
                          Height="160" HorizontalAlignment="Center"
                          VerticalAlignment="Center" x:SetterTargetType="Border"
                          Opacity="0.9" RenderTransform="scale(0.92) rotate(0deg)"
                          RenderTransformOrigin="50%,50%" ZIndex="4">
                          <Setter Property="Background" Value="#FF1D2A46"/>
                          <Setter Property="BorderBrush" Value="#FF5277B7"/>
                          <Setter Property="CornerRadius" Value="28"/>
                        </motion:MotionSlot>
                        <motion:MotionSlot
                          x:Name="TimelineStatus" Margin="0,0,0,16"
                          HorizontalAlignment="Center" VerticalAlignment="Bottom"
                          Opacity="0.72" ZIndex="5"/>
                      </Panel>
                    </DataTemplate>
                  </motion:TimelineMotionKeyFrame>
                </motion:TimelineMotion>
              </motion:MotionPanel.Motion>

              <Border
                x:Name="TimelineHalo" Background="#0F79A7FF"
                BorderBrush="#667CA8FF" BorderThickness="1"
                CornerRadius="999">
                <Border
                  Margin="24" BorderBrush="#337CA8FF"
                  BorderThickness="1" CornerRadius="999"/>
              </Border>

              <Border
                x:Name="TimelineCore" Classes="TimelineTile">
                <Grid
                  ColumnDefinitions="Auto,*" ColumnSpacing="12"
                  RowDefinitions="Auto,*,Auto" RowSpacing="8">
                  <Border
                    Grid.Row="0" Grid.Column="0"
                    Width="40" Height="40"
                    Background="#FF35598E" CornerRadius="12">
                    <lucide:LucideIcon
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="White" Kind="Sparkles"
                      Size="20" StrokeWidth="1.8"/>
                  </Border>
                  <StackPanel
                    Grid.Row="0" Grid.Column="1"
                    VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                      Classes="TimelineKicker" Text="MOTION CORE"/>
                    <TextBlock
                      FontSize="20" FontWeight="SemiBold"
                      Foreground="White" Text="Constellation"/>
                  </StackPanel>
                  <TextBlock
                    Classes="TimelineBody" Grid.Row="1"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    Text="One stable visual identity, authored across absolute key times."/>
                  <Grid
                    Grid.Row="2" Grid.Column="0"
                    Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                    <Border
                      Grid.Column="0" Height="4"
                      VerticalAlignment="Center" Background="#FF34415B"
                      CornerRadius="2">
                      <Border
                        Width="112" HorizontalAlignment="Left"
                        Background="#FF7CA8FF" CornerRadius="2"/>
                    </Border>
                    <TextBlock
                      Classes="TimelineKicker" Grid.Column="1"
                      Margin="12,0,0,0" Text="FRAME SYNC"/>
                  </Grid>
                </Grid>
              </Border>

              <Border
                x:Name="SignalAlpha" Classes="TimelineSignal"
                ClipToBounds="True">
                <DockPanel
                  HorizontalAlignment="Center" HorizontalSpacing="12"
                  RenderTransform="scale(1.4)">
                  <lucide:LucideIcon
                    DockPanel.Dock="Left" VerticalAlignment="Center"
                    Foreground="#FF6FB7FF" Kind="Radio"
                    Size="20" StrokeWidth="1.8"/>
                  <StackPanel
                    VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                      Classes="TimelineKicker" Text="SIGNAL A"/>
                    <TextBlock
                      FontWeight="SemiBold" Foreground="White"
                      Text="Position"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <Border
                x:Name="SignalBeta" Classes="TimelineSignal"
                ClipToBounds="True">
                <DockPanel
                  HorizontalAlignment="Center" HorizontalSpacing="12"
                  RenderTransform="scale(1.4)">
                  <lucide:LucideIcon
                    DockPanel.Dock="Left" VerticalAlignment="Center"
                    Foreground="#FF7FE0B6" Kind="Activity"
                    Size="20" StrokeWidth="1.8"/>
                  <StackPanel
                    VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                      Classes="TimelineKicker" Text="SIGNAL B"/>
                    <TextBlock
                      FontWeight="SemiBold" Foreground="White"
                      Text="Transform"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <Border
                x:Name="SignalGamma" Classes="TimelineSignal"
                ClipToBounds="True">
                <Panel>
                  <DockPanel
                    x:Name="Header" HorizontalAlignment="Center"
                    HorizontalSpacing="12" RenderTransform="scale(1.4)">
                    <lucide:LucideIcon
                      DockPanel.Dock="Left" VerticalAlignment="Center"
                      Foreground="#FFD797FF" Kind="Zap"
                      Size="20" StrokeWidth="1.8"/>
                    <StackPanel
                      VerticalAlignment="Center" Spacing="2">
                      <TextBlock
                        Classes="TimelineKicker" Text="SIGNAL C"/>
                      <TextBlock
                        FontWeight="SemiBold" Foreground="White"
                        Text="Property"/>
                    </StackPanel>
                  </DockPanel>

                  <DockPanel
                    x:Name="Details" ClipToBounds="True"
                    Opacity="0">
                    <StackPanel
                      DockPanel.Dock="Bottom" Margin="16,0,16,16"
                      Orientation="Horizontal" Spacing="8">
                      <Border
                        Padding="8,4" Background="#267F52A8"
                        CornerRadius="8">
                        <SelectableTextBlock
                          Classes="TimelineKicker" Foreground="#FFE5C8FF"
                          Text="LAYOUT"/>
                      </Border>
                      <Border
                        Padding="8,4" Background="#267F52A8"
                        CornerRadius="8">
                        <SelectableTextBlock
                          Classes="TimelineKicker" Foreground="#FFE5C8FF"
                          Text="TRANSFORM"/>
                      </Border>
                      <Border
                        Padding="8,4" Background="#267F52A8"
                        CornerRadius="8">
                        <SelectableTextBlock
                          Classes="TimelineKicker" Foreground="#FFE5C8FF"
                          Text="STYLE"/>
                      </Border>
                    </StackPanel>

                    <StackPanel
                      Margin="24" Spacing="12">
                      <SelectableTextBlock
                        MaxWidth="440" HorizontalAlignment="Left"
                        FontSize="28" FontWeight="SemiBold"
                        Foreground="White" Text="One timeline. Every property."
                        TextWrapping="Wrap"/>
                      <SelectableTextBlock
                        MaxWidth="440" HorizontalAlignment="Left"
                        FontSize="14" Foreground="#FFD8C9E8"
                        LineHeight="22" Text="Layout bounds, opacity, brushes, corners, and transforms are sampled through one interpolation pipeline while the real control keeps its identity."
                        TextWrapping="Wrap"/>
                    </StackPanel>
                  </DockPanel>
                </Panel>
              </Border>

              <Border
                x:Name="TimelineStatus" Padding="12,8"
                Background="#D9141C2B" BorderBrush="#FF34415A"
                BorderThickness="1" CornerRadius="16">
                <StackPanel
                  Orientation="Horizontal" Spacing="8">
                  <Border
                    Width="8" Height="8"
                    VerticalAlignment="Center" Background="#FF7FE0B6"
                    CornerRadius="4"/>
                  <TextBlock
                    Classes="TimelineKicker" VerticalAlignment="Center"
                    Text="LIVE LAYOUT · NO SNAPSHOTS"/>
                </StackPanel>
              </Border>
            </motion:MotionPanel>
          </Border>
        </StackPanel>
      </controls:DemoExample>
    </StackPanel>
  </ScrollViewer>
</UserControl>