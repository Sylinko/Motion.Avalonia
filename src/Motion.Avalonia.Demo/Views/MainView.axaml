<UserControl
  x:Class="Motion.Avalonia.Demo.Views.MainView" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:views="using:Motion.Avalonia.Demo.Views" d:DesignHeight="800"
  d:DesignWidth="1180" mc:Ignorable="d">

  <Grid
    Background="{DynamicResource WindowBackgroundColor}"
    ColumnDefinitions="Auto,*">
    <shadui:NavigationBar
      x:Name="Navigation" Grid.Column="0"
      Margin="12,12,0,12">
      <shadui:NavigationBarItem
        x:Name="OverviewNavigationItem" Content="Overview"
        Icon="LayoutDashboard" IsChecked="True"
        Route="overview" ToolTip="Overview"/>
      <shadui:NavigationBarItem
        x:Name="InteractionMotionNavigationItem" Content="Interactions"
        Icon="MousePointerClick" Route="interactions"
        ToolTip="Interaction motion gallery"/>
      <shadui:NavigationBarItem
        x:Name="LayoutNavigationItem" Content="Layout morphing"
        Icon="AppWindow" Route="layout"
        ToolTip="Layout morphing"/>
      <shadui:NavigationBarItem
        x:Name="StateMotionNavigationItem" Content="State motion"
        Icon="SlidersHorizontal" Route="state-motion"
        ToolTip="State motion"/>
      <shadui:NavigationBarItem
        x:Name="PropertiesNavigationItem" Content="Target properties"
        Icon="Palette" Route="properties"
        ToolTip="Target properties"/>
      <shadui:NavigationBarItem
        x:Name="KeyFrameMotionNavigationItem" Content="Keyframe motion"
        Icon="Shapes" Route="keyframes"
        ToolTip="Sequence and timeline motion"/>
    </shadui:NavigationBar>

    <Grid
      Grid.Column="1" RowDefinitions="Auto,*">
      <Border
        Padding="24,16"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel
            Orientation="Horizontal" Spacing="8">
            <PathIcon
              Width="20" Height="20"
              VerticalAlignment="Center"
              Data="{x:Static shadui:Icons.Logo}"/>
            <TextBlock
              VerticalAlignment="Center" FontSize="16"
              FontWeight="SemiBold" Text="Motion.Avalonia"/>
          </StackPanel>
          <Border
            Grid.Column="1" Padding="12,4"
            Background="{DynamicResource SecondaryColor}"
            CornerRadius="12">
            <TextBlock
              FontSize="12" FontWeight="SemiBold"
              Text="LAYOUT MOTION LAB"/>
          </Border>
        </Grid>
      </Border>

      <Carousel
        x:Name="Pages" Grid.Row="1"
        SelectedIndex="0">
        <views:OverviewPage/>
        <views:InteractionMotionPage/>
        <views:LayoutMorphingPage/>
        <views:StateMotionPage/>
        <views:TargetPropertiesPage/>
        <views:KeyFrameMotionPage/>
      </Carousel>
    </Grid>
  </Grid>
</UserControl>
