<UserControl
  x:Class="Motion.Avalonia.Demo.Views.OverviewPage" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Motion.Avalonia.Demo.Controls"
  xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia" xmlns:motion="using:Motion.Avalonia"
  xmlns:shadui="clr-namespace:ShadUI.Controls;assembly=ShadUI">
  <UserControl.Styles>
    <Style Selector="Button.VideoChrome">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="shadui:ButtonAssist.IconSize" Value="20"/>
    </Style>

    <Style Selector="Button.ShowcaseAction">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Foreground" Value="#FF6A737D"/>
      <Setter Property="shadui:ButtonAssist.IconSize" Value="20"/>
    </Style>

    <Style Selector="Button.ShowcaseAction.Like">
      <Setter Property="Foreground" Value="#FFFF435A"/>
    </Style>

    <Style Selector="Border.ShowcaseComment">
      <Setter Property="MaxWidth" Value="280"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Background" Value="#FFE4E7EB"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="Border.ShowcaseComment.Alternate">
      <Setter Property="Background" Value="#FFDDE1E5"/>
    </Style>

    <Style Selector="TextBlock.ShowcaseCommentText">
      <Setter Property="Foreground" Value="#FF27313B"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="Run.ShowcaseCommentAuthor">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#FF16729A"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel
      MaxWidth="{StaticResource DemoPageMaxWidth}"
      Margin="{StaticResource DemoPageMargin}"
      HorizontalAlignment="Stretch" Spacing="32">
      <StackPanel Spacing="8">
        <TextBlock
          Classes="DemoEyebrow" Text="SHOWCASE"/>
        <TextBlock
          Classes="DemoTitle" Text="One screen. Three live layouts."/>
        <TextBlock
          Classes="DemoDescription" MaxWidth="768"
          HorizontalAlignment="Left" Text="Scroll inside the phone. The video, author bar, actions, comments, and composer are stable controls projected through three responsive state templates—without snapshots, fake scaling, or fixed animated offsets."/>
      </StackPanel>

      <controls:DemoExample
        Title="Scroll-driven short video" HorizontalContentAlignment="Stretch"
        Description="The hidden ScrollViewer supplies native wheel, touchpad, and slider progress. Its first stop is an immersive player, the middle stop reveals the conversation, and the final stop replaces the video with a Continue playing control.">
        <Grid
          ColumnDefinitions="*,Auto,*" ColumnSpacing="24">
          <StackPanel
            Grid.Column="0" MaxWidth="256"
            VerticalAlignment="Center" Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock
                FontSize="12" FontWeight="SemiBold"
                Foreground="{DynamicResource PrimaryColor}"
                Text="SCROLL PROGRESS"/>
              <TextBlock
                x:Name="ShowcaseProgressLabel" FontFamily="Cascadia Mono,Consolas"
                FontSize="24" FontWeight="SemiBold"
                Text="0.00"/>
              <TextBlock
                x:Name="ShowcaseStateLabel"
                Foreground="{DynamicResource MutedColor}"
                Text="Immersive"/>
            </StackPanel>

            <StackPanel Spacing="4">
              <Slider
                x:Name="ShowcaseProgressSlider" LargeChange="0.1"
                Maximum="1" Minimum="0"
                SmallChange="0.01" ValueChanged="OnShowcaseProgressSliderValueChanged"/>
              <DockPanel>
                <TextBlock
                  Classes="Muted" DockPanel.Dock="Left"
                  FontSize="12" Text="Video"/>
                <TextBlock
                  Classes="Muted" DockPanel.Dock="Right"
                  FontSize="12" Text="Discussion"/>
              </DockPanel>
            </StackPanel>

            <TextBlock
              Classes="DemoDescription" Text="Scroll over the phone or drag the slider. Reverse direction at any point: every visual state is derived directly from the current offset."/>

            <StackPanel Spacing="8">
              <Button
                Classes="Secondary"
                shadui:ButtonAssist.Icon="{LucideIconContent Play}"
                Click="OnImmersiveClick" Content="Back to video"/>
              <Button
                Classes="Primary"
                shadui:ButtonAssist.Icon="{LucideIconContent MessageCircle}"
                Click="OnDiscussionClick" Content="Open discussion"/>
            </StackPanel>
          </StackPanel>

          <Border
            Grid.Column="1" Width="392"
            Height="704" Background="#FF05070B"
            BoxShadow="0 24 70 0 #59000000" ClipToBounds="True"
            CornerRadius="24">
            <ScrollViewer
              x:Name="ShowcaseScrollViewer" HorizontalScrollBarVisibility="Disabled"
              ScrollChanged="OnShowcaseScrollChanged" VerticalScrollBarVisibility="Hidden">
              <controls:PinnedScrollStage
                x:Name="ShowcaseScrollStage" TransitionDistance="920"
                ViewportHeight="704">
                <motion:MotionPanel
                  x:Name="ShowcasePanel" ClipToBounds="True">
                  <motion:MotionPanel.Controller>
                    <controls:ShowcaseSequenceController x:Name="ShowcaseController"/>
                  </motion:MotionPanel.Controller>

                  <motion:MotionPanel.States>
                    <motion:MotionState Key="Immersive">
                      <motion:MotionState.Template>
                        <DataTemplate>
                          <Panel>
                            <motion:MotionSlot Target="VideoSurface"/>
                            <motion:MotionSlot
                              Height="0" VerticalAlignment="Bottom"
                              Opacity="0" Target="DiscussionSurface"/>
                            <motion:MotionSlot
                              MaxWidth="256" Margin="16"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              x:SetterTargetType="Border" Target="AuthorBar">
                              <Setter Property="CornerRadius" Value="16"/>
                              <Setter Property="BorderThickness" Value="1"/>
                            </motion:MotionSlot>
                            <StackPanel
                              Width="48" Margin="0,0,12,72"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Orientation="Vertical">
                              <motion:MotionSlot
                                Width="48" Height="48"
                                Target="LikeButton"/>
                              <motion:MotionSlot
                                Width="48" Height="48"
                                Target="ShareButton"/>
                              <motion:MotionSlot
                                Width="48" Height="48"
                                Target="MoreButton"/>
                            </StackPanel>
                            <motion:MotionSlot
                              Height="52" Margin="12"
                              HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                              Target="CommentComposer"/>
                            <motion:MotionSlot
                              Margin="0,0,0,72" HorizontalAlignment="Center"
                              VerticalAlignment="Bottom" Target="ScrollHint"/>
                          </Panel>
                        </DataTemplate>
                      </motion:MotionState.Template>
                    </motion:MotionState>

                    <motion:MotionState Key="Reveal">
                      <motion:MotionState.Template>
                        <DataTemplate>
                          <Grid RowDefinitions="312,*,64">
                            <motion:MotionSlot
                              Grid.Row="0" Opacity="0"
                              Target="ContinuePlayback"/>
                            <motion:MotionSlot
                              Grid.Row="0" MaxWidth="224"
                              HorizontalAlignment="Center" Target="VideoSurface"/>
                            <motion:MotionSlot
                              Grid.Row="1" Grid.RowSpan="2"
                              Target="DiscussionSurface"/>
                            <motion:MotionSlot
                              Grid.Row="1" Height="56"
                              VerticalAlignment="Top" x:SetterTargetType="Border"
                              Target="AuthorBar">
                              <Setter Property="CornerRadius" Value="0"/>
                              <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </motion:MotionSlot>
                            <motion:MotionSlot
                              Grid.Row="1" Margin="8,64,8,8"
                              Target="CommentList"/>
                            <DockPanel Grid.Row="2">
                              <StackPanel
                                DockPanel.Dock="Right" Margin="0,8,8,8"
                                Orientation="Horizontal">
                                <motion:MotionSlot
                                  Width="48" Height="48"
                                  Target="LikeButton"/>
                                <motion:MotionSlot
                                  Width="48" Height="48"
                                  Target="ShareButton"/>
                                <motion:MotionSlot
                                  Width="48" Height="48"
                                  Target="MoreButton"/>
                              </StackPanel>
                              <motion:MotionSlot
                                Margin="8" Target="CommentComposer"/>
                            </DockPanel>
                          </Grid>
                        </DataTemplate>
                      </motion:MotionState.Template>
                    </motion:MotionState>

                    <motion:MotionState Key="Discussion">
                      <motion:MotionState.Template>
                        <DataTemplate>
                          <Grid RowDefinitions="56,56,*,64">
                            <motion:MotionSlot Target="ContinuePlayback"/>
                            <motion:MotionSlot
                              Grid.Row="1" Grid.RowSpan="3"
                              Target="DiscussionSurface"/>
                            <motion:MotionSlot
                              Grid.Row="1" x:SetterTargetType="Border"
                              Target="AuthorBar">
                              <Setter Property="CornerRadius" Value="0"/>
                              <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </motion:MotionSlot>
                            <motion:MotionSlot
                              Grid.Row="2" Margin="8"
                              Target="CommentList"/>
                            <DockPanel Grid.Row="3">
                              <StackPanel
                                DockPanel.Dock="Right" Margin="0,8,8,8"
                                Orientation="Horizontal">
                                <motion:MotionSlot
                                  Width="48" Height="48"
                                  Target="LikeButton"/>
                                <motion:MotionSlot
                                  Width="48" Height="48"
                                  Target="ShareButton"/>
                                <motion:MotionSlot
                                  Width="48" Height="48"
                                  Target="MoreButton"/>
                              </StackPanel>
                              <motion:MotionSlot
                                Margin="8" Target="CommentComposer"/>
                            </DockPanel>
                          </Grid>
                        </DataTemplate>
                      </motion:MotionState.Template>
                    </motion:MotionState>
                  </motion:MotionPanel.States>

                  <Border
                    x:Name="VideoSurface" Background="#FF05070B"
                    ClipToBounds="True">
                    <Image
                      Source="/Assets/short-video-frame.png" Stretch="UniformToFill"/>
                  </Border>

                  <Border
                    x:Name="DiscussionSurface" Background="#FFF8FAFC"/>

                  <DockPanel
                    x:Name="ContinuePlayback" Background="#FF20242A"
                    HorizontalSpacing="12">
                    <Button
                      Classes="Ghost Compact Uniform Rounded VideoChrome" DockPanel.Dock="Left"
                      Width="40" Margin="16,0,0,0"
                      shadui:ButtonAssist.Icon="{LucideIconContent ArrowLeft}"
                      ToolTip.Tip="Back"/>

                    <Button
                      Classes="Ghost Compact Uniform Rounded VideoChrome" DockPanel.Dock="Right"
                      Width="40" Margin="0,0,16,0"
                      shadui:ButtonAssist.Icon="{LucideIconContent EllipsisVertical}"
                      ToolTip.Tip="More"/>

                    <Button
                      Classes="Ghost VideoChrome" HorizontalContentAlignment="Center"
                      shadui:ButtonAssist.Icon="{LucideIconContent Play}"
                      Content="Continue playing" CornerRadius="0"
                      FontSize="16" FontWeight="SemiBold"/>
                  </DockPanel>

                  <Border
                    x:Name="CommentList" Background="Transparent">
                    <StackPanel Spacing="8">
                      <Border Classes="ShowcaseComment">
                        <TextBlock Classes="ShowcaseCommentText">
                          <Run
                            Classes="ShowcaseCommentAuthor" Text="Cloud Atlas: "/>
                          <Run Text="This transition feels so natural."/>
                        </TextBlock>
                      </Border>
                      <Border
                        Classes="ShowcaseComment Alternate" MaxWidth="300">
                        <TextBlock Classes="ShowcaseCommentText">
                          <Run
                            Classes="ShowcaseCommentAuthor" Text="Mika: "/>
                          <Run Text="The player never lost its identity."/>
                        </TextBlock>
                      </Border>
                      <Border
                        Classes="ShowcaseComment" MaxWidth="260">
                        <TextBlock Classes="ShowcaseCommentText">
                          <Run
                            Classes="ShowcaseCommentAuthor" Text="Old Deer: "/>
                          <Run Text="Scroll back—the whole motion is reversible."/>
                        </TextBlock>
                      </Border>
                      <Border
                        Classes="ShowcaseComment Alternate" MaxWidth="288">
                        <TextBlock Classes="ShowcaseCommentText">
                          <Run
                            Classes="ShowcaseCommentAuthor" Text="Autumn: "/>
                          <Run Text="No snapshots, just live layout."/>
                        </TextBlock>
                      </Border>
                    </StackPanel>
                  </Border>

                  <Border
                    x:Name="AuthorBar" Padding="8"
                    Background="#EDFFFFFF" BorderBrush="#24000000">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <Border
                        Width="36" Height="36"
                        Background="#FFBBD8EF" ClipToBounds="True"
                        CornerRadius="18">
                        <Image
                          Source="/Assets/short-video-frame.png" Stretch="UniformToFill"/>
                      </Border>
                      <StackPanel
                        Grid.Column="1" Margin="8,0"
                        VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                          FontSize="12" FontWeight="SemiBold"
                          Foreground="#FF161A20" Text="Mira in motion"/>
                        <TextBlock
                          FontSize="12" Foreground="#FF68717C"
                          Text="@mira.layout"/>
                      </StackPanel>
                      <Button
                        Classes="Primary" Grid.Column="3"
                        Height="32" MinWidth="72"
                        Padding="12,0" VerticalAlignment="Center"
                        Content="+ Follow"
                        CornerRadius="{DynamicResource FullCornerRadius}"/>
                    </Grid>
                  </Border>

                  <Button
                    x:Name="LikeButton" Classes="Ghost Rounded ShowcaseAction Like"
                    shadui:ButtonAssist.Icon="{LucideIconContent Heart}"
                    ToolTip.Tip="Like"/>
                  <Button
                    x:Name="ShareButton" Classes="Ghost Rounded ShowcaseAction"
                    shadui:ButtonAssist.Icon="{LucideIconContent Share2}"
                    ToolTip.Tip="Share"/>
                  <Button
                    x:Name="MoreButton" Classes="Ghost Rounded ShowcaseAction"
                    shadui:ButtonAssist.Icon="{LucideIconContent Ellipsis}"
                    ToolTip.Tip="More"/>

                  <Border
                    x:Name="CommentComposer" Padding="8"
                    Background="#E9FFFFFF" BorderBrush="#33000000"
                    BorderThickness="1" CornerRadius="16">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox
                        VerticalContentAlignment="Center" Background="Transparent"
                        BorderThickness="0" Foreground="#FF20252B"
                        PlaceholderText="Say something..." SelectionBrush="#556835A5"/>
                      <lucide:LucideIcon
                        Grid.Column="1" VerticalAlignment="Center"
                        Foreground="#FF7D858F" Kind="Smile"
                        Size="18" StrokeWidth="1.8"/>
                    </Grid>
                  </Border>

                  <Border
                    x:Name="ScrollHint" Padding="12,8"
                    Background="#8A10151B" CornerRadius="16">
                    <StackPanel
                      Orientation="Horizontal" Spacing="8">
                      <lucide:LucideIcon
                        VerticalAlignment="Center" Kind="Mouse"
                        Size="12" StrokeWidth="1.8"/>
                      <TextBlock
                        VerticalAlignment="Center" FontSize="11"
                        Foreground="White" Text="Scroll for comments"/>
                    </StackPanel>
                  </Border>
                </motion:MotionPanel>
              </controls:PinnedScrollStage>
            </ScrollViewer>
          </Border>

          <StackPanel
            Grid.Column="2" MaxWidth="256"
            VerticalAlignment="Center" Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock
                FontWeight="SemiBold" Text="What stays real"/>
              <TextBlock
                Classes="DemoDescription" Text="The Image is measured at every intermediate bound. Author, actions, comments, and TextBox remain their original control instances."/>
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Text="✓  Live state templates"/>
              <TextBlock Text="✓  Reversible pose seeking"/>
              <TextBlock Text="✓  Native scroll input"/>
              <TextBlock Text="✓  Stable control identity"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </controls:DemoExample>
    </StackPanel>
  </ScrollViewer>
</UserControl>
