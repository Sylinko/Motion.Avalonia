<Window
  x:Class="Motion.Avalonia.Demo.Views.MainWindow" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:views="using:Motion.Avalonia.Demo.Views" Title="Motion.Avalonia"
  Width="1180" Height="800"
  MinWidth="860" MinHeight="620"
  Icon="/Assets/avalonia-logo.ico" WindowStartupLocation="CenterScreen">

  <Grid
    Background="{DynamicResource WindowBackgroundColor}"
    ColumnDefinitions="Auto,*">
    <shadui:NavigationBar
      x:Name="Navigation" Grid.Column="0"
      Margin="12,12,0,12">
      <shadui:NavigationBarItem
        x:Name="OverviewNavigationItem" Content="Overview"
        Icon="LayoutDashboard" IsChecked="True"
        Route="overview" ToolTip="Overview"/>
      <shadui:NavigationBarItem
        x:Name="LayoutNavigationItem" Content="Layout morphing"
        Icon="AppWindow" Route="layout"
        ToolTip="Layout morphing"/>
      <shadui:NavigationBarItem
        x:Name="BasicControllerNavigationItem" Content="Basic controller"
        Icon="SlidersHorizontal" Route="basic-controller"
        ToolTip="Basic controller"/>
      <shadui:NavigationBarItem
        x:Name="PropertiesNavigationItem" Content="Target properties"
        Icon="Palette" Route="properties"
        ToolTip="Target properties"/>
      <shadui:NavigationBarItem
        x:Name="PoseNavigationItem" Content="Controller &amp; pose"
        Icon="Shapes" Route="pose"
        ToolTip="Controller and pose"/>
    </shadui:NavigationBar>

    <Grid
      Grid.Column="1" RowDefinitions="Auto,*">
      <Border
        Padding="24,16"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel
            Orientation="Horizontal" Spacing="8">
            <PathIcon
              Width="20" Height="20"
              VerticalAlignment="Center"
              Data="{x:Static shadui:Icons.Logo}"/>
            <TextBlock
              VerticalAlignment="Center" FontSize="16"
              FontWeight="SemiBold" Text="Motion.Avalonia"/>
          </StackPanel>
          <Border
            Grid.Column="1" Padding="12,4"
            Background="{DynamicResource SecondaryColor}"
            CornerRadius="12">
            <TextBlock
              FontSize="12" FontWeight="SemiBold"
              Text="LAYOUT MOTION LAB"/>
          </Border>
        </Grid>
      </Border>

      <Carousel
        x:Name="Pages" Grid.Row="1"
        SelectedIndex="0">
        <views:OverviewPage/>
        <views:LayoutMorphingPage/>
        <views:BasicControllerPage/>
        <views:TargetPropertiesPage/>
        <views:ControllerPosePage/>
      </Carousel>
    </Grid>
  </Grid>
</Window>
