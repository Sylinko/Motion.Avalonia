<Window
  x:Class="Motion.Avalonia.Demo.Views.MainWindow" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="using:Motion.Avalonia"
  Title="Motion.Avalonia" Width="1100"
  Height="720" MinWidth="760"
  MinHeight="520" Icon="/Assets/avalonia-logo.ico">

  <Grid
    Margin="24" RowDefinitions="Auto,*"
    RowSpacing="18">
    <StackPanel
      Orientation="Horizontal" Spacing="12">
      <Button
        x:Name="ModeButton" Click="OnModeButtonClick"
        Content="Switch to advanced"/>
      <TextBlock
        VerticalAlignment="Center"
        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
        Text="Resize the window to verify that state templates remain live."/>
    </StackPanel>

    <Border
      Grid.Row="1" Padding="18"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1" CornerRadius="12">
      <motion:TransitionPanel
        x:Name="EditorPanel" ClipToBounds="True"
        State="Quick" StateTransitionDuration="0:0:0.45"
        StateTransitionEasing="CubicEaseInOut">
        <motion:TransitionPanel.States>
          <motion:TransitionPanelState Key="Quick">
            <motion:TransitionPanelState.Template>
              <DataTemplate>
                <Grid>
                  <motion:TransitionPanelSlot
                    MaxWidth="600" HorizontalAlignment="Stretch"
                    Target="QuickEditor"/>
                  <motion:TransitionPanelSlot
                    MaxWidth="600" HorizontalAlignment="Stretch"
                    x:SetterTargetType="Border" Opacity="0"
                    Target="AdvancedEditor">
                    <Setter Property="Background" Value="#FF3C284D"/>
                  </motion:TransitionPanelSlot>
                </Grid>
              </DataTemplate>
            </motion:TransitionPanelState.Template>
          </motion:TransitionPanelState>

          <motion:TransitionPanelState Key="Advanced">
            <motion:TransitionPanelState.Template>
              <DataTemplate>
                <DockPanel HorizontalSpacing="24">
                  <Grid
                    DockPanel.Dock="Left" MaxWidth="420">
                    <motion:TransitionPanelSlot
                      Opacity="0" Target="QuickEditor"/>
                    <motion:TransitionPanelSlot
                      x:SetterTargetType="Border" Target="AdvancedEditor">
                      <Setter Property="Background" Value="#FF243D59"/>
                    </motion:TransitionPanelSlot>
                  </Grid>
                  <motion:TransitionPanelSlot Target="Preview"/>
                </DockPanel>
              </DataTemplate>
            </motion:TransitionPanelState.Template>
          </motion:TransitionPanelState>
        </motion:TransitionPanel.States>

        <Border
          x:Name="QuickEditor" Padding="22"
          Background="{DynamicResource AccentControlBackgroundColorDefaultBrush}"
          CornerRadius="10">
          <StackPanel Spacing="14">
            <TextBlock
              FontSize="24" FontWeight="SemiBold"
              Text="Quick editor"/>
            <TextBlock
              Text="A concise editor that is centered and constrained by MaxWidth 600." TextWrapping="Wrap"/>
            <TextBox PlaceholderText="What should the assistant do?"/>
            <TextBox
              MinHeight="160" AcceptsReturn="True"
              PlaceholderText="Additional requirements" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border
          x:Name="AdvancedEditor" Padding="22"
          Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
          CornerRadius="10">
          <Grid
            RowDefinitions="Auto,Auto,*" RowSpacing="14">
            <TextBlock
              FontSize="24" FontWeight="SemiBold"
              Text="Advanced editor"/>
            <TextBox
              Grid.Row="1" PlaceholderText="Prompt name"/>
            <TextBox
              Grid.Row="2" MinHeight="260"
              AcceptsReturn="True" PlaceholderText="System prompt"
              TextWrapping="Wrap"/>
          </Grid>
        </Border>

        <Border
          x:Name="Preview" Padding="22"
          Background="{DynamicResource ControlAltFillColorTertiaryBrush}"
          CornerRadius="10">
          <StackPanel Spacing="14">
            <TextBlock
              FontSize="24" FontWeight="SemiBold"
              Text="Live preview"/>
            <TextBlock
              Text="The preview fades without changing the layout contract of the editor." TextWrapping="Wrap"/>
            <Border
              Padding="18"
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
              CornerRadius="8">
              <TextBlock
                FontFamily="Cascadia Mono,Consolas" Text="You are a concise and thoughtful assistant..."
                TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </Border>
      </motion:TransitionPanel>
    </Border>
  </Grid>
</Window>
